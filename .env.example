# Public origin, used for canonical URLs, sitemap and Open Graph tags (build time). Required in production.
SITE_URL=https://qrtools.example.com

# Optional: Plausible analytics domain (build time). Also add https://plausible.io to CSP_SCRIPT_SRC and CSP_CONNECT_SRC.
PUBLIC_PLAUSIBLE_DOMAIN=

# Ads stay off until an ad network is configured (build time).
PUBLIC_ADS_ENABLED=false

# Runtime
PORT=8080
LOG_LEVEL=info
# Analytics events accepted per visitor per minute.
EVENTS_PER_MINUTE=240

# Extra CSP sources (space or comma separated), e.g. for an ad network later.
CSP_SCRIPT_SRC=
CSP_CONNECT_SRC=
CSP_IMG_SRC=
CSP_FRAME_SRC=
