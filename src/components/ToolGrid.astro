---
import ToolCard from './ToolCard.astro';
import type { Tool } from '../data/tools';
interface Props {
  tools: Tool[];
  headingLevel?: 'h2' | 'h3';
  flagship?: string;
}
const { tools, headingLevel = 'h3', flagship } = Astro.props;
---

<ul class="tool-grid" role="list">
  {
    tools.map((t) => (
      <li>
        <ToolCard tool={t} headingLevel={headingLevel} flagship={t.slug === flagship} />
      </li>
    ))
  }
</ul>

<style>
  .tool-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-3);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 150px), 1fr));
  }
  @media (min-width: 700px) {
    .tool-grid {
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: var(--s-4);
    }
  }
</style>
