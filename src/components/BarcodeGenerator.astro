      <label class="label" for="barcode-value">What should your barcode contain?</label>
      <input class="field" id="barcode-value" data-barcode-value value="123456789012" autocomplete="off" spellcheck="false" aria-describedby="barcode-hint barcode-error" />
      <p class="hint" id="barcode-hint">Enter a product number, SKU or short text. The value stays in your browser.</p>

