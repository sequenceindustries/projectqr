---
/** Contextual cross-links: "Need a Wi-Fi QR code? → Wi-Fi QR Code". */
import { toolBySlug } from '../data/tools';
interface Props {
  prompts: { q: string; slug: string }[];
}
const { prompts } = Astro.props;
---

<nav class="prompts" aria-label="Other QR tools">
  <ul role="list">
    {
      prompts.map((p) => (
        <li>
          <span>{p.q}</span>
          <a href={`/${p.slug}`}>{toolBySlug.get(p.slug)?.name} →</a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
    gap: var(--s-2);
  }
  li {
    display: grid;
    gap: 2px;
    padding: var(--s-3) var(--s-4);
    border-radius: var(--r-md);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  span {
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  a {
    font-weight: 700;
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
  }
</style>
