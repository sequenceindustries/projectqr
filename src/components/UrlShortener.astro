---
/**
 * URL shortener UI. Unlike the other tools, a short link must be stored on
 * our server so it keeps working; the page says so plainly.
 */
---

<section class="shortener" data-shortener aria-label="URL shortener">
  <form class="card in" data-short-form novalidate>
    <div class="field">
      <label class="label big" for="short-url">Long link</label>
      <input class="input" id="short-url" data-short-url type="url" inputmode="url" autocomplete="url" autocapitalize="off" spellcheck="false" placeholder="https://example.com/a/very/long/link?campaign=spring" aria-describedby="short-url-err" required />
      <span class="field-error" id="short-url-err" data-short-url-err></span>
    </div>

    <details class="custom" data-short-custom>
      <summary>Customise the ending <span>(optional)</span></summary>
      <div class="field">
        <label class="label" for="short-alias">Custom ending</label>
        <div class="alias-row">
          <span class="prefix" data-short-prefix aria-hidden="true">/s/</span>
          <input class="input" id="short-alias" data-short-alias type="text" autocomplete="off" autocapitalize="off" spellcheck="false" maxlength="32" placeholder="spring-menu" aria-describedby="short-alias-hint short-alias-err" />
        </div>
        <span class="field-hint" id="short-alias-hint">3–32 letters, numbers or dashes. Leave empty for a random ending.</span>
        <span class="field-error" id="short-alias-err" data-short-alias-err></span>
      </div>
    </details>

    <p class="notice notice--error" data-short-error role="alert" hidden></p>
    <button type="submit" class="btn btn--block go" data-short-go>Shorten link</button>
    <p class="pill-note"><span class="lock-dot" aria-hidden="true"></span> Short links are saved on our server so they keep working. Don’t shorten private or secret links.</p>
  </form>

  <div class="card out" data-short-result hidden tabindex="-1">
    <p class="eyebrow">Your short link</p>
    <div class="result-row">
      <a class="short" data-short-link href="#" target="_blank" rel="noopener noreferrer"></a>
      <button type="button" class="btn copy" data-short-copy>Copy</button>
    </div>
    <p class="dest">Goes to <span data-short-dest></span></p>
    <p class="done" data-short-status aria-live="polite"></p>

    <div class="qr-row">
      <div class="qr finder" data-short-qr role="img" aria-label="QR code for the short link"></div>
      <div class="qr-actions">
        <p class="qr-t">QR code for this link</p>
        <p class="field-hint">Shorter links make simpler QR codes that scan faster.</p>
        <div class="qr-btns">
          <button type="button" class="btn btn--quiet btn--small" data-short-dl="png">Download PNG</button>
          <button type="button" class="btn btn--quiet btn--small" data-short-dl="svg">Download SVG</button>
        </div>
        <a class="small-link" data-short-preview href="#" target="_blank" rel="noopener">Check where it goes</a>
      </div>
    </div>
    <button type="button" class="again" data-short-again>Shorten another link</button>
  </div>

  <section class="card recent" data-short-recent hidden aria-labelledby="recent-h">
    <div class="recent-head">
      <h2 id="recent-h">Recent links</h2>
      <button type="button" class="link-btn" data-short-clear>Clear</button>
    </div>
    <p class="field-hint">Saved in this browser only, so you can find them again.</p>
    <ul data-short-recent-list></ul>
  </section>
</section>

<script>
  import { mountShorteners } from '../scripts/shortener';
  mountShorteners();
</script>

<style>
  .shortener { display: grid; gap: var(--s-4); max-width: 820px; }
  .card { border-radius: var(--r-lg); background: var(--surface); box-shadow: inset 0 0 0 1px var(--line), var(--lift); }
  .in, .out, .recent { display: grid; gap: var(--s-4); padding: var(--s-5); }
  @media (max-width: 599px) { .in, .out, .recent { padding: var(--s-4); } }
  .out { border-top: 6px solid var(--mark); }
  .out:focus { outline: none; }
  .field { display: grid; gap: var(--s-1); }
  .big { font-size: var(--step-0); color: var(--ink); }
  .field-error:empty { display: none; }
  .custom summary { min-height: 44px; display: flex; align-items: center; gap: var(--s-1); font-weight: 650; cursor: pointer; }
  .custom summary { list-style: none; }
  .custom summary::-webkit-details-marker { display: none; }
  .custom summary::before { content: ''; width: 8px; height: 8px; margin: 0 6px 0 2px; border-right: 2px solid var(--ink); border-bottom: 2px solid var(--ink); transform: rotate(-45deg); transition: transform .15s; }
  .custom[open] summary::before { transform: rotate(45deg); }
  .custom summary span { color: var(--ink-soft); font-weight: 500; }
  .custom[open] summary { margin-bottom: var(--s-2); }
  .alias-row { display: flex; align-items: stretch; min-width: 0; }
  .prefix { display: flex; align-items: center; padding: 0 var(--s-3); border-radius: var(--r-md) 0 0 var(--r-md); background: var(--paper); box-shadow: inset 0 0 0 1.5px var(--line-strong); color: var(--ink-soft); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.9rem; white-space: nowrap; max-width: 55%; overflow: hidden; text-overflow: ellipsis; }
  .alias-row .input { border-top-left-radius: 0; border-bottom-left-radius: 0; min-width: 0; flex: 1; }
  .go { min-height: 56px; font-size: var(--step-1); }
  .eyebrow { margin: 0; color: var(--ink-soft); font-size: var(--step--1); font-weight: 700; text-transform: uppercase; letter-spacing: .06em; }
  .result-row { display: flex; gap: var(--s-2); align-items: stretch; flex-wrap: wrap; }
  .short { flex: 1 1 240px; min-width: 0; display: flex; align-items: center; min-height: 56px; padding: var(--s-3) var(--s-4); border-radius: var(--r-md); background: var(--paper); font: 700 var(--step-1)/1.3 ui-monospace, SFMono-Regular, Menlo, monospace; overflow-wrap: anywhere; text-decoration: none; color: var(--ink); }
  .short:hover { text-decoration: underline; }
  .copy { min-width: 110px; }
  .dest { font-size: var(--step--1); color: var(--ink-soft); overflow-wrap: anywhere; }
  .dest span { color: var(--ink); }
  .done { font-size: var(--step--1); color: var(--ok); font-weight: 600; }
  .done:empty { display: none; }
  .qr-row { display: grid; grid-template-columns: 140px 1fr; gap: var(--s-5); align-items: center; padding-top: var(--s-4); border-top: 1px solid var(--line); }
  @media (max-width: 480px) { .qr-row { grid-template-columns: 1fr; justify-items: start; } }
  .qr { --f-inset: -8px; --f-len: 18px; --f-w: 3px; width: 140px; aspect-ratio: 1; margin: 8px; }
  .qr :global(svg) { width: 100%; height: 100%; display: block; border-radius: 6px; }
  .qr-actions { display: grid; gap: var(--s-2); }
  .qr-t { font-weight: 700; }
  .qr-btns { display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .small-link { font-weight: 650; font-size: var(--step--1); min-height: 44px; display: inline-flex; align-items: center; }
  .again, .link-btn { justify-self: start; min-height: 44px; padding: 0; border: 0; background: none; color: var(--signal); font: 650 var(--step-0) var(--font-body); text-decoration: underline; text-underline-offset: .2em; cursor: pointer; }
  .recent-head { display: flex; justify-content: space-between; align-items: center; }
  .recent h2 { font-size: var(--step-1); }
  .recent ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-2); }
  .recent :global(li) { display: grid; grid-template-columns: 1fr auto; gap: var(--s-1) var(--s-3); align-items: center; padding: var(--s-3); border-radius: var(--r-md); background: var(--paper); min-width: 0; }
  .recent :global(li a) { font: 650 0.95rem ui-monospace, SFMono-Regular, Menlo, monospace; overflow-wrap: anywhere; }
  .recent :global(li small) { grid-column: 1; color: var(--ink-soft); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .recent :global(li button) { grid-row: 1 / 3; grid-column: 2; }
</style>
