<section class="password-gen" data-password-generator aria-label="Password generator">
  <div class="card controls">
    <label class="label" for="password-length">Password length</label>
    <div class="length-control">
      <input id="password-length" data-password-length type="range" min="8" max="64" value="20" />
      <output data-password-length-output for="password-length">20 characters</output>
    </div>

    <fieldset>
      <legend class="label">Include characters</legend>
      <label class="option"><input type="checkbox" data-password-set="lower" checked /> Lowercase letters <span>a–z</span></label>
      <label class="option"><input type="checkbox" data-password-set="upper" checked /> Uppercase letters <span>A–Z</span></label>
      <label class="option"><input type="checkbox" data-password-set="numbers" checked /> Numbers <span>0–9</span></label>
      <label class="option"><input type="checkbox" data-password-set="symbols" checked /> Symbols <span>!@#$…</span></label>
    </fieldset>

    <label class="option"><input type="checkbox" data-password-avoid /> Avoid look-alike characters <span>i, l, 1, o, 0</span></label>
    <p class="hint">Create a different password for every account. Your password stays on this device.</p>
  </div>

  <div class="card result-card">
    <p class="eyebrow">Your new password</p>
    <div class="result-wrap">
      <output class="result" data-password-result aria-live="polite"></output>
      <button class="btn btn--quiet copy" type="button" data-password-copy aria-label="Copy password">Copy</button>
    </div>
    <p class="error" data-password-error role="alert" hidden></p>
    <button class="btn btn--primary" type="button" data-password-generate>Generate password</button>
    <p class="privacy-note">Generated in your browser with its secure random generator. Nothing is uploaded or saved.</p>
  </div>
</section>

<script>
  import { mountPasswordGenerators } from '../scripts/password';
  mountPasswordGenerators();
</script>

<style>
  .password-gen { display:grid; gap:var(--s-4); grid-template-columns:minmax(0,1fr); align-items:start; }
  .card { min-width:0; padding:var(--s-5); border-radius:var(--r-lg); background:var(--surface); box-shadow:inset 0 0 0 1px var(--line),var(--lift); }
  .controls { display:grid; gap:var(--s-4); }
  .label { font-weight:700; }
  .length-control { display:grid; gap:var(--s-2); }
  .length-control input { width:100%; accent-color:var(--signal); }
  .length-control output { color:var(--ink-soft); font-size:var(--step--1); }
  fieldset { display:grid; gap:var(--s-2); margin:0; padding:0; border:0; }
  fieldset legend { margin-bottom:var(--s-2); }
  .option { display:flex; gap:var(--s-2); align-items:center; min-height:40px; }
  .option input { width:18px; height:18px; accent-color:var(--signal); }
  .option span { margin-left:auto; color:var(--ink-soft); font-size:var(--step--1); }
  .hint,.privacy-note { color:var(--ink-soft); font-size:var(--step--1); }
  .hint { margin:0; }
  .result-card { display:grid; gap:var(--s-4); align-content:start; }
  .eyebrow { margin:0; color:var(--ink-soft); font-size:var(--step--1); font-weight:700; text-transform:uppercase; letter-spacing:.06em; }
  .result-wrap { display:flex; gap:var(--s-2); align-items:stretch; }
  .result { flex:1; min-width:0; min-height:64px; padding:var(--s-3); display:grid; align-items:center; overflow-wrap:anywhere; border:1px solid var(--line); border-radius:var(--r-sm); background:#fff; color:var(--ink); font:600 1.05rem/1.5 ui-monospace,SFMono-Regular,Menlo,monospace; }
  .copy { align-self:stretch; }
  .error { margin:0; color:var(--err); font-weight:650; }
  .privacy-note { margin:0; }
  @media (min-width:820px) { .password-gen { grid-template-columns:minmax(0,1fr) minmax(320px,.95fr); gap:var(--s-5); } }
</style>
