---
/** Mark: a simple code pattern with one lime signal bar. */
interface Props {
  size?: number;
  light?: boolean;
}
const { size = 30, light = false } = Astro.props;
const ink = light ? '#ffffff' : '#13151f';
---

<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <rect x="3" y="5" width="4" height="22" rx="1.2" fill={ink}></rect>
  <rect x="10" y="9" width="3" height="14" rx="1" fill={ink}></rect>
  <rect x="16" y="5" width="5" height="22" rx="1.2" fill={ink}></rect>
  <rect x="24" y="8" width="3" height="16" rx="1" fill="#c6f432" stroke={ink} stroke-width="1"></rect>
  <rect x="29" y="5" width="2" height="22" rx="1" fill={ink}></rect>
</svg>
