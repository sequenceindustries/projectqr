---
import Base from '../layouts/Base.astro';
import ToolGrid from '../components/ToolGrid.astro';
import { tools } from '../data/tools';
---

<Base title="About Code Generator" description="Code Generator is a free browser-based toolkit from Sequence Industries for creating QR codes and barcodes." path="/about">
  <article class="wrap prose">
    <h1>About Code Generator</h1>
    <p class="lede">One clear place to create and read QR codes and barcodes.</p>
    <p>Code Generator is built by Sequence Industries. Create a QR code for a link, contact or Wi-Fi network, or make a barcode for a product or inventory label. There are no accounts, trials or watermarks.</p>
    <p>Codes are generated in your browser, so the values you enter stay on your device. QR designs are scan-checked before download, and barcode formats are clearly labelled so you can choose the one your product or system requires.</p>
  </article>
  <section class="wrap tools" aria-labelledby="t-h">
    <h2 id="t-h">The tools</h2>
    <ToolGrid tools={tools} />
  </section>
</Base>

<style>
  .prose {
    max-width: calc(var(--measure) + 2 * var(--gutter));
    padding-top: var(--s-5);
  }
  .prose h1 {
    font-size: var(--step-4);
    margin-bottom: var(--s-4);
  }
  .lede {
    font-size: var(--step-1);
    margin-bottom: var(--s-5);
  }
  .prose p + p {
    margin-top: var(--s-3);
  }
  .prose p:not(.lede) {
    color: var(--ink-soft);
    line-height: 1.7;
  }
  .tools {
    margin-top: var(--s-8);
  }
  .tools h2 {
    margin-bottom: var(--s-5);
  }
</style>
