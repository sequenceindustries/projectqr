---
import Base from '../layouts/Base.astro';
import QRCodeGenerator from '../components/QRCodeGenerator.astro';
import UrlShortener from '../components/UrlShortener.astro';
import ToolGrid from '../components/ToolGrid.astro';
import FAQSection from '../components/FAQSection.astro';
import AdSlot from '../components/AdSlot.astro';
import { tools, toolBySlug } from '../data/tools';
import { BRAND, ORG } from '../data/site';

const site = Astro.site!.toString().replace(/\/$/, '');
const pick = (slugs: string[]) => slugs.map((s) => toolBySlug.get(s)!).filter(Boolean);
const qrTools = pick(['qr-code-generator', 'custom-qr-code', 'wifi-qr-code', 'vcard-qr-code', 'qr-code-scanner', 'qr-code-reader', 'batch-qr-code']);
const linkTools = pick(['url-shortener']);
const moreTools = pick(['barcode-generator', 'password-generator', 'word-search-maker']);

const faqs = [
  { q: `Is ${BRAND} free?`, a: 'Yes. QR codes, short links and every other tool are free, with no account, no watermark and no limit on how many you make.' },
  { q: 'Do the QR codes expire?', a: 'No. QR codes made here are static: the link or details are stored inside the code itself, so it keeps working for as long as the destination does.' },
  { q: 'Can I add my logo to a QR code?', a: 'Yes. Open “Customise design” or use the Custom QR Code tool to add a logo, change colours and pick a pattern. Every design is scan-checked before you download it.' },
  { q: 'How does the URL shortener work?', a: 'Paste a long link and get a short one, with an optional custom ending and a matching QR code. Add a + to the end of any short link to see where it goes before you open it.' },
  { q: 'Is my data private?', a: 'QR codes, barcodes and passwords are created in your browser and never uploaded. The URL shortener is the one exception: short links are saved on our server so they keep working, with no record of who opens them.' },
  { q: 'Should I download PNG or SVG?', a: 'PNG for screens, documents and social media. SVG for printing and design tools, because it stays sharp at any size.' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: BRAND,
    url: site + '/',
    description: 'Free QR code generator and URL shortener.',
    publisher: { '@type': 'Organization', name: ORG },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: BRAND,
    url: site + '/',
    logo: site + '/icon-512.png',
    parentOrganization: { '@type': 'Organization', name: ORG },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: `${BRAND} QR Code Generator & URL Shortener`,
    url: site + '/',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    browserRequirements: 'Requires JavaScript',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  { '@context': 'https://schema.org', '@type': 'ItemList', itemListElement: tools.map((t, i) => ({ '@type': 'ListItem', position: i + 1, name: t.name, url: `${site}/${t.slug}` })) },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---

<Base
  title={`${BRAND} — Free QR Code Generator & URL Shortener`}
  description="Create free QR codes for links, Wi-Fi and contacts, add your logo, and shorten long links with a matching QR code. No sign-up, no watermark."
  path="/"
  jsonLd={jsonLd}
>
  <section class="hero wrap" aria-labelledby="hero-h">
    <div class="copy">
      <p class="eyebrow">{BRAND} · free, no sign-up</p>
      <h1 id="hero-h">QR code generator and URL shortener.</h1>
      <p class="lede">Make a QR code for any link, Wi-Fi network or contact — or turn a long link into a short one with its own QR code.</p>
    </div>
    <div class="code-maker">
      <div class="mode-toggle" role="tablist" aria-label="What do you want to make?">
        <button id="qr-tab" type="button" role="tab" aria-selected="true" aria-controls="qr-panel" data-code-tab="qr">QR code</button>
        <button id="link-tab" type="button" role="tab" aria-selected="false" aria-controls="link-panel" data-code-tab="link" tabindex="-1">Short link</button>
      </div>
      <div id="qr-panel" role="tabpanel" aria-labelledby="qr-tab" data-code-panel="qr">
        <QRCodeGenerator tool="home" />
      </div>
      <div id="link-panel" role="tabpanel" aria-labelledby="link-tab" data-code-panel="link" hidden>
        <UrlShortener tool="home" />
      </div>
    </div>
  </section>

  <section class="tools wrap" aria-labelledby="tools-h">
    <div class="section-heading">
      <div><p class="eyebrow">Create, design and scan</p><h2 id="tools-h">QR code tools</h2></div>
      <a href="/qr-code-generator">Open the QR code generator <span aria-hidden="true">→</span></a>
    </div>
    <ToolGrid tools={qrTools} flagship="qr-code-generator" />
  </section>

  <section class="tools wrap" aria-labelledby="links-h">
    <div class="section-heading">
      <div><p class="eyebrow">Shorter links, simpler QR codes</p><h2 id="links-h">URL shortener</h2></div>
      <a href="/url-shortener">Shorten a link <span aria-hidden="true">→</span></a>
    </div>
    <div class="link-pitch">
      <ToolGrid tools={linkTools} flagship="url-shortener" />
      <ul class="points">
        <li><strong>Custom endings.</strong> Pick a memorable link like /s/spring-menu.</li>
        <li><strong>QR code included.</strong> Shorter links make simpler codes that scan faster.</li>
        <li><strong>Safe to share.</strong> Add a + to any short link to preview where it goes.</li>
      </ul>
    </div>
  </section>

  <section class="tools wrap" aria-labelledby="more-h">
    <div class="section-heading">
      <div><p class="eyebrow">Also free</p><h2 id="more-h">More generators</h2></div>
    </div>
    <ToolGrid tools={moreTools} />
  </section>

  <AdSlot name="home-mid" />

  <section class="how wrap" aria-labelledby="how-h">
    <h2 id="how-h">Enter. Generate. Download.</h2>
    <ol>
      <li>
        <h3>Enter</h3>
        <p>Paste a link, or fill in Wi-Fi, contact or message details. Your QR code appears as you type.</p>
      </li>
      <li>
        <h3>Make it yours</h3>
        <p>Pick colours and a pattern, add your logo, or shorten the link first for a cleaner code.</p>
      </li>
      <li>
        <h3>Download</h3>
        <p>Save a crisp PNG or SVG. No account, no watermark, and static QR codes never expire.</p>
      </li>
    </ol>
  </section>

  <section class="private wrap" aria-labelledby="priv-h">
    <div class="priv-card">
      <h2 id="priv-h">QR codes are made in your browser.</h2>
      <p>Links, Wi-Fi passwords and contact details you turn into QR codes never leave your device. Short links are saved on our server so they keep working — with no record of who opens them.</p>
      <a href="/privacy">How we handle data</a>
    </div>
  </section>

  <div class="wrap faq-wrap">
    <FAQSection faqs={faqs} />
  </div>

  <script>
    const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-code-tab]')];
    const panels = [...document.querySelectorAll<HTMLElement>('[data-code-panel]')];
    const select = (tab: HTMLButtonElement, focus = false) => {
      const selected = tab.dataset.codeTab;
      tabs.forEach((item) => {
        const on = item === tab;
        item.setAttribute('aria-selected', String(on));
        item.tabIndex = on ? 0 : -1;
      });
      panels.forEach((panel) => (panel.hidden = panel.dataset.codePanel !== selected));
      if (focus) tab.focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
          e.preventDefault();
          select(tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length], true);
        }
      });
    });
    if (location.hash === '#short-link') select(tabs[1]);
  </script>
</Base>

<style>
  .hero {
    display: grid;
    gap: var(--s-5);
    padding-block: var(--s-3) var(--s-7);
  }
  .copy {
    display: grid;
    gap: var(--s-3);
    max-width: 44rem;
  }
  h1 {
    font-size: clamp(2.4rem, 1.4rem + 4.2vw, 4.6rem);
    max-width: 16ch;
  }
  .lede {
    font-size: var(--step-1);
    color: var(--ink-soft);
    max-width: 40ch;
  }
  .tools {
    margin-top: var(--s-6);
  }
  .section-heading {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: var(--s-3);
    margin-bottom: var(--s-5);
  }
  .section-heading h2 {
    margin: 0;
  }
  .section-heading a {
    color: var(--signal-deep);
    font-weight: 700;
    text-decoration: none;
  }
  .section-heading a:hover {
    text-decoration: underline;
  }
  .eyebrow {
    color: var(--ink-soft);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .mode-toggle {
    display: flex;
    width: fit-content;
    max-width: 100%;
    margin-bottom: var(--s-4);
    padding: 4px;
    gap: 4px;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    background: var(--surface);
  }
  .mode-toggle button {
    min-height: 42px;
    padding: 0.5rem 1.1rem;
    border: 0;
    border-radius: var(--r-pill);
    background: transparent;
    color: var(--ink-soft);
    font: 700 var(--step--1) / 1 var(--font-body);
    cursor: pointer;
  }
  .mode-toggle button[aria-selected='true'] {
    background: var(--ink);
    color: #fff;
  }
  .link-pitch {
    display: grid;
    gap: var(--s-5);
    align-items: center;
  }
  @media (min-width: 760px) {
    .link-pitch {
      grid-template-columns: minmax(220px, 300px) 1fr;
    }
  }
  .points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-3);
    color: var(--ink-soft);
  }
  .points strong {
    color: var(--ink);
  }
  .tools h2,
  .how h2 {
    margin-bottom: var(--s-5);
  }
  .how {
    margin-top: var(--s-9);
  }
  .how ol {
    list-style: none;
    counter-reset: step;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-5);
  }
  @media (min-width: 760px) {
    .how ol {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .how li {
    counter-increment: step;
    display: grid;
    gap: var(--s-2);
    align-content: start;
  }
  .how li::before {
    content: counter(step);
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--ink);
    color: var(--mark);
    font: 700 var(--step-1) / 1 var(--font-display);
    margin-bottom: var(--s-2);
  }
  .how p {
    color: var(--ink-soft);
  }
  .private {
    margin-top: var(--s-9);
  }
  .priv-card {
    display: grid;
    gap: var(--s-3);
    padding: var(--s-7) var(--s-6);
    border-radius: var(--r-xl);
    background: var(--ink);
    color: #d6d8e0;
  }
  .priv-card h2 {
    color: #fff;
    max-width: 18ch;
  }
  .priv-card p {
    max-width: 52ch;
    font-size: var(--step-1);
  }
  .priv-card a {
    color: var(--mark);
    font-weight: 700;
  }
  .priv-card a:hover {
    color: #fff;
  }
  .priv-card :focus-visible {
    outline-color: var(--mark);
  }
  @media (max-width: 599px) {
    .priv-card {
      padding: var(--s-6) var(--s-5);
    }
  }
  .faq-wrap {
    margin-top: var(--s-9);
    max-width: calc(var(--measure) + 2 * var(--gutter));
    margin-inline: 0 auto;
  }
  @media (min-width: 1180px) {
    .faq-wrap {
      margin-inline: auto;
      max-width: var(--page);
    }
    .faq-wrap :global(.faq) {
      max-width: var(--measure);
    }
  }
</style>
