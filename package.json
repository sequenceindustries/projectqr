{
  "name": "qrtools",
  "version": "0.1.0",
  "description": "QR Tools — create, customise and read QR codes in your browser. Free, no account.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:api": "tsx watch server/index.ts",
    "build": "astro build && tsc -p tsconfig.server.json",
    "start": "node build/server/index.js",
    "test": "vitest run",
    "check": "astro check && tsc -p tsconfig.server.json --noEmit",
    "test:e2e": "tsx test/e2e/make_fixtures.ts && python3 test/e2e/run.py test/e2e/fixtures",
    "assets": "tsx scripts/make-assets.ts"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "astro": "^5.18.2",
    "fastify": "^5.12.5",
    "fflate": "^0.8.3",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.5",
    "axe-core": "^4.13.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
